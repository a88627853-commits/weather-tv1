<!DOCTYPE html>
<html>
<head>
<title>Weather TV</title>

<style>
body {
    margin: 0;
    background: black;
    color: white;
    font-family: Arial;
}

#tv {
    width: 960px;
    height: 960px;
    margin: auto;
    background: #111;
    overflow: auto;
    position: relative;
}

#ticker {
    position: fixed;
    bottom: 0;
    width: 100%;
    background: black;
    color: lime;
    white-space: nowrap;
    overflow: hidden;
}

#ticker span {
    display: inline-block;
    padding-left: 100%;
    animation: scroll 20s linear infinite;
}

@keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
}

#eas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: red;
    color: white;
    font-size: 50px;
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 9999;
}

#fx {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}
</style>
</head>

<body>

<button onclick="document.documentElement.requestFullscreen()">FULLSCREEN</button>

<div id="tv"></div>

<div id="ticker"><span>LOADING...</span></div>

<div id="eas"></div>

<canvas id="fx"></canvas>

<script>

const fx = document.getElementById("fx");
const ctx = fx.getContext("2d");

fx.width = window.innerWidth;
fx.height = window.innerHeight;

let lastSpeak = "";

function speakQueue(lines, i = 0) {
    if (i >= lines.length) return;

    let msg = new SpeechSynthesisUtterance(lines[i]);
    msg.lang = "pl-PL";
    msg.rate = 1;

    msg.onend = () => {
        setTimeout(() => speakQueue(lines, i + 1), 400);
    };

    speechSynthesis.speak(msg);
}

function showEAS(text) {
    let e = document.getElementById("eas");
    e.style.display = "flex";
    e.innerText = text;

    let msg = new SpeechSynthesisUtterance(text);
    msg.lang = "pl-PL";
    speechSynthesis.speak(msg);

    setTimeout(() => e.style.display = "none", 8000);
}

function ticker(data) {
    let text = data.cities.map(c =>
        `${c.name}: ${c.current?.temperature_2m ?? "?"}°C`
    ).join(" | ");

    document.querySelector("#ticker span").innerText = text;
}

function checkEAS(data) {
    let msg = "";

    for (let c of data.cities) {
        let cur = c.current || {};
        let h = c.hourly || {};

        let wind = h.wind_speed_10m?.[0] ?? 0;
        let rain = h.precipitation_probability?.[0] ?? 0;
        let code = cur.weather_code ?? 0;

        if (code >= 95) msg = "⛈ BURZE NAD POLSKĄ - ALERT EAS";
        if (wind > 20) msg = "🌪 SILNE WIATRY - ALERT EAS";
        if (rain > 70) msg = "🌧 INTENSYWNE OPADY - ALERT EAS";
    }

    if (msg) showEAS(msg);
}

function weatherFX(code) {
    ctx.clearRect(0,0,fx.width,fx.height);

    if (code >= 95) {
        if (Math.random() > 0.85)
            ctx.fillRect(Math.random()*fx.width, Math.random()*fx.height, 200, 2);
    }
    else if (code >= 61) {
        for (let i=0;i<80;i++)
            ctx.fillRect(Math.random()*fx.width, Math.random()*fx.height, 2, 10);
    }
    else if (code >= 71) {
        for (let i=0;i<60;i++) {
            ctx.beginPath();
            ctx.arc(Math.random()*fx.width, Math.random()*fx.height, 3, 0, Math.PI*2);
            ctx.fill();
        }
    }
}

function buildTTS(data) {
    let lines = [];

    data.cities.forEach(c => {

        let cur = c.current || {};
        let h = c.hourly || {};

        lines.push(
`${c.name}. Temperatura ${cur.temperature_2m ?? "brak"} stopni. 
Wilgotność ${cur.relative_humidity_2m ?? "brak"} procent. 
Odczuwalna ${cur.apparent_temperature ?? "brak"}. 
Wiatr ${h.wind_speed_10m?.[0] ?? 0} metrów na sekundę. 
Zachmurzenie ${cur.cloud_cover ?? 0} procent. 
Ciśnienie ${cur.pressure_msl ?? "brak"}. 
Widoczność ${cur.visibility ?? "brak"}. 
Opady ${h.precipitation?.[0] ?? 0}. Szansa ${h.precipitation_probability?.[0] ?? 0} procent. 
Śnieg ${h.snow_depth?.[0] ?? 0}. 
UV ${h.uv_index?.[0] ?? 0}. 
Dzień/noc ${cur.is_day ? "dzień" : "noc"}.`
        );
    });

    return lines;
}

function load() {
    fetch("/data")
        .then(r => r.json())
        .then(d => {

            ticker(d);
            checkEAS(d);

            let main = d.cities[13];

            weatherFX(main.current?.weather_code || 0);

            speakQueue(buildTTS(d));

            document.getElementById("tv").innerHTML =
                d.cities.map(c =>
                    `<div>${c.name} | ${c.current?.temperature_2m ?? "?"}°C</div>`
                ).join("");
        });
}

setInterval(load, 60000);
load();

</script>

</body>
</html>
